# ─── Supabase (클라우드 무료 프로젝트) ───────────────────────────
# supabase.com → 프로젝트 → Settings → API 에서 복사
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...      # Secret key (또는 옛 service_role 키). 서버 전용 — 절대 웹/깃에 올리지 말 것
SUPABASE_BUCKET=audio

# ─── 추론 ─────────────────────────────────────────────────────
# MOCK=1 이면 모델 없이도 전체 흐름이 돌아감 (발표 안전장치)
MOCK=1
DEVICE=cpu
CKPT_PATH=/models/best.pt               # 컨테이너 안 경로 (compose에서 마운트)
SER_SRC=/app/ser_src                    # 학습 코드(model.py 등)를 마운트할 경로
HF_HOME=/models/hf                      # WavLM 사전학습 가중치 캐시

# ─── 분석 파라미터 ─────────────────────────────────────────────
WIN_SEC=3.0
HOP_SEC=1.5
SAMPLE_RATE=16000
MAX_DURATION_SEC=1800
MAX_UPLOAD_MB=100

# ─── 기타 ─────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=8080
WORKER_POLL_SEC=2
